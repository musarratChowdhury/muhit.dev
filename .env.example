# Copy to `.env.local` and fill in. `.env.local` is gitignored.

# ── Firebase (client SDK) ──────────────────────────────────────────────────
# Project settings → General → Your apps → Web app → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── Firebase Admin SDK (server only) ───────────────────────────────────────
# Either a path to the service-account JSON (local dev)…
FIREBASE_SERVICE_ACCOUNT_PATH=
# …or the whole JSON as one line (hosting providers that only take env vars).
# FIREBASE_SERVICE_ACCOUNT=

# ── Admin access ───────────────────────────────────────────────────────────
# Comma-separated allow-list of emails permitted into /admin.
ADMIN_EMAILS=

# ── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://muhit.dev
